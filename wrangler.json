{
  "keep_vars": true,
  "name": "propertydamageclaimstraining",
  "compatibility_date": "2024-09-23",
  "main": "worker.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/slides/*",
      "/documents/*"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "LSH_KV",
      "id": "b121aa911590471bbad351d03274d7f4"
    }
  ],
  "r2_buckets": [
    {
      "binding": "DOCUMENTS",
      "bucket_name": "lshtraining"
    }
  ],
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "placement": {
    "mode": "targeted",
    "region": "gcp:us-central1"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GEMINI_RELAY",
        "class_name": "GeminiRelay"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-gemini-relay",
      "new_sqlite_classes": [
        "GeminiRelay"
      ]
    }
  ]
}
